{% liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
%}
{{ 'pod.css' | asset_url | stylesheet_tag }}
{% style %}  
  #shopify-section-{{ section.id }} .wemustpod-hero {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width:749px) {
    #shopify-section-{{ section.id }} .wemustpod-hero {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }    
  }
{% endstyle %}

<div class="wemustpod-hero">

  <div class="wemustpod-hero-bg">

    {% if desktop_image != blank %}
      {{
        desktop_image
        | image_url: width: 2000
        | image_tag:
          class: 'desktop-image',
          loading: 'lazy',
          widths: '768,1200,1600,2000'
      }}
    {% endif %}

    {% if mobile_image != blank %}
      {{
        mobile_image
        | image_url: width: 900
        | image_tag:
          class: 'mobile-image',
          loading: 'lazy',
          widths: '375,550,750,900'
      }}
    {% endif %}

  </div>

  <div class="container">
    <div class="wemustpod-hero-inner">
      <div class="wemustpod-hero-content">
        {% if section.settings.heading != blank %}
          <h2 class="wemustpod-hero-title">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <h3 class="wemustpod-hero-subtitle">
            {{ section.settings.subheading }}
          </h3>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="wemustpod-hero-desc rte">
            {{ section.settings.description }}
          </div>
        {% endif %}
        {% if section.settings.button_text != blank %}
          <a
            href="{{ section.settings.button_link }}"
            class="wemustpod-hero-btn"
          >
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pod Banner",
  "tag": "section",
  "class": "section pod-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Banner Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Banner Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Print On Demand"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "For Canada and the USA"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>One partner for apparel, drinkware, stickers, patches, embroidery, and more. Fully automated. Zero minimums. Built for brands that want to grow without adding fulfillment complexity.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Get Started"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Pod Banner"
    }
  ]
}
{% endschema %}