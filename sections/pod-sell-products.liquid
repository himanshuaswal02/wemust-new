{{ 'decoration-page.css' | asset_url | stylesheet_tag }}
<style>
    /* ─────────────────────────────────────────
       SELL (Products)
    ───────────────────────────────────────── */

    .wemustpod-sell-section {
        background: var(--sell-section-background);
        padding-top: var(--sell-section-padding-top);
        padding-bottom: var(--sell-section-padding-bottom);
    }
    .wemustpod-sell-header {
        text-align: center;
        max-width: 760px;
        margin: 0 auto 40px;
    }
    
    .wemustpod-sell-eyebrow {
        
        font-size: 18px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-align: center;
        color: #AAAAAA;
        margin:0;
        padding-bottom:20px;
    }
    
    .wemustpod-sell-title {
        
        font-size: 30px;
        font-weight: 700;
        color: #000000;
        margin:0;
        padding-bottom:20px;
    }
    
    .wemustpod-sell-text {
        
        font-size: 15px;
        font-weight: 400;
        color: #000000;
        margin:0;
    }
    
    .wemustpod-sell-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
    }
    .wemustpod-sell-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    @media screen and (max-width: 767px) {
    .wemustpod-sell-section {
        padding-top: calc(var(--sell-section-padding-top)/ 2);
        padding-bottom: calc(var(--sell-section-padding-bottom)/2);
    }
    .wemustpod-sell-header {
        max-width: 350px;
        margin:0 auto 20px;
    }
    }
</style>
<div
    class="wemustpod-sell-section"
    style="
      --sell-section-background: {{ section.settings.background }};
      --sell-section-padding-top: {{ section.settings.padding_top }}px;
      --sell-section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="container">
      <div class="wemustpod-sell-header">
        {% if section.settings.eyebrow != blank %}
          <p class="wemustpod-sell-eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="wemustpod-sell-title">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="wemustpod-sell-text rte">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
      <div class="wemustpod-sell-grid">
        {% for block in section.blocks %}
          {% case block.type %}
          {% when 'product' %}
          <article
            class="wemustpod-sell-card"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 308
                | image_tag:
                  loading: 'lazy',
                  class: 'wemustpod-sell-image',
                  alt: block.settings.alt
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </article>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
</div>
{% schema %}

{
  "name": "POD Sell Products",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What you can sell"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More products. Less vendor management."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>When you order online, you get access to top-selling print-on-demand products with no minimums, fast 24–48 hour production on select items, and shipping options across the US and Canada.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],

  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt Text",
          "default": "Product"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "POD Sell Products",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "alt": "Apparel Via DTF"
          }
        },
        {
          "type": "product",
          "settings": {
            "alt": "DTG Apparel"
          }
        },
        {
          "type": "product",
          "settings": {
            "alt": "Promotional Sticker Sets"
          }
        },
        {
          "type": "product",
          "settings": {
            "alt": "Promotional Magnets"
          }
        },
        {
          "type": "product",
          "settings": {
            "alt": "Embroidery Patches"
          }
        },
        {
          "type": "product",
          "settings": {
            "alt": "Drinkware"
          }
        },
        {
          "type": "product",
          "settings": {
            "alt": "Embroidery Patch Keychains"
          }
        },
        {
          "type": "product",
          "settings": {
            "alt": "Wall Stickers"
          }
        },
        {
          "type": "product",
          "settings": {
            "alt": "One-Off Embroidery"
          }
        }
      ]
    }
  ]
}

{% endschema %}