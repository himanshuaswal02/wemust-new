{{ 'instructions.css' | asset_url | stylesheet_tag }}

<section
  class="instructions-section"
  style="
    --instructions-bg: {{ section.settings.background }};
    --instructions-text: {{ section.settings.text_color }};
    --instructions-padding-top: {{ section.settings.padding_top }}px;
    --instructions-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="container">

    <div class="instructions-section__header">
      {% if section.settings.heading != blank %}
        <h2 class="instructions-section__title">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
    </div>

    <div class="instructions-section__content">
      {% if section.settings.content != blank %}
        <div class="instructions-section__text rte">
          {{ section.settings.content }}
        </div>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Instructions",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Instructions"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Add your instructions here.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F2F5F6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#54585A"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Instructions"
    }
  ]
}
{% endschema %}