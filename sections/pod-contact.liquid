<style>
    /* ─────────────────────────────────────────
       CONTACT
    ───────────────────────────────────────── */
    .wemustpod-contact-section {
        padding-top: var(--contact-section-padding-top);
        padding-bottom: var(--contact-section-padding-bottom);
        background: var(--contact-section-background);
    }
    .wemustpod-contact-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 70px;
        align-items: start;
    }
    .wemustpod-contact-left{
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    
    @media (max-width: 860px) {
        .wemustpod-contact-layout {
            grid-template-columns: 1fr;
        }
    }
    
    .wemustpod-contact-title {
        font-size: 40px;
        font-weight: 700;
        color: #000000;
        margin: 0;
    }

    .wemustpod-contact-text {
        font-size: 16px;
        font-weight: 400;
        line-height: 27px;
        margin-bottom: 0.9rem;
        max-width: 90%;
        color: #7A7A7A;
    }
    
    .wemustpod-contact-art {
        display: flex;
        flex-wrap: nowrap;
        gap: 0;
    }
    
    .wemustpod-contact-art-col {
        display: flex;
        flex-direction: column;
        min-width:219px;
        width: 100%;
    }
    
    .wemustpod-contact-art-col img {
        border-radius: 6px;
        width: 100%;
        object-fit: cover;
    }
    
    .wemustpod-contact-cta {
      background-color: rgba(134, 21, 40, 0.9);
      color:#FFF;
      font-size: 16px;
      font-weight: 700;
      line-height: 20px;
      border-radius: 8px;
      padding: 15px;
    transition: background 0.2s;
    max-width: 238px;
    text-align: center;
    max-height: 50px;
    }
    
    .wemustpod-contact-cta:hover {
        background: #861528;
    }
    
    .wemustpod-contact-offices {
        display: flex;
        flex-direction: column;
        gap: 20px;
        background: #861528;
        padding: 30px;
        border-radius: 50px;
    }
    
    .wemustpod-contact-office {
        display: flex;
        flex-direction: column;
        gap: 16px;
        align-items: flex-start;
        
    }
    
    .wemustpod-contact-office img {
      width: 100%;
      height: 150px;
      object-fit: cover;
      object-position: center center;
      border-radius: 20px;
        flex-shrink: 0;
    }
    
    .wemustpod-contact-office-meta {
       display: flex;
       gap: 20px;
       align-items: center;
   }

   .wemustpod-contact-office-number {
     height: 65px;
     width: 65px;
     background: #9b4c5c;
     font-weight: 700;
     flex-shrink: 0;
     line-height: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      border-radius: 50%;
      font-size: 24px;
      color: #fff;
    }
    
    .wemustpod-contact-office h3 {
      font-family: "Roboto", Sans-serif;
      font-weight: 400;
      color: #FFFFFF;
      font-size: 16px;
      transition: color 0.3s;
      margin-bottom: 4px;
  }
    
    .wemustpod-contact-office p {
      font-family: "Roboto", Sans-serif;
      font-weight: 400;
      color: #FFFFFF;
      font-size: 16px;
      transition: color 0.3s;
      margin:0;
    }
    
    /* ─────────────────────────────────────────
           Responsive
        ───────────────────────────────────────── */
  /* ==========================================
   Tablet
========================================== */

@media screen and (max-width: 990px) {

  .wemustpod-contact-layout{
      grid-template-columns:1fr;
      gap:40px;
  }

  .wemustpod-contact-left,
  .wemustpod-contact-offices{
      width:100%;
  }

  .wemustpod-contact-text{
      max-width:100%;
  }

  .wemustpod-contact-art{
      justify-content:center;
  }

  .wemustpod-contact-art-col{
      min-width:0;
      flex:1;
  }

}


/* ==========================================
 Mobile
========================================== */

@media screen and (max-width: 767px){

  .wemustpod-contact-section{
      padding-top:calc(var(--contact-section-padding-top) / 2);
      padding-bottom:calc(var(--contact-section-padding-bottom) / 2);
  }

  .wemustpod-contact-layout{
      grid-template-columns:1fr;
  }

  .wemustpod-contact-left,
  .wemustpod-contact-offices{
      width:100%;
  }

  .wemustpod-contact-art{
      flex-wrap:wrap;
  }

  .wemustpod-contact-art-col{
      min-width:calc(50% - 5px);
      flex:1 1 calc(50% - 5px);
  }

  .wemustpod-contact-art-col img{
      width:100%;
      height:auto;
  }

  .wemustpod-contact-cta{
      width:100%;
      max-width:100%;
  }

  .wemustpod-contact-offices{
      padding:20px;
      border-radius:30px;
  }

  .wemustpod-contact-office{
      width:100%;
  }

  .wemustpod-contact-office img{
      width:100%;
      height:auto;
  }

  .wemustpod-contact-office-meta{
      align-items:flex-start;
  }

}


/* ==========================================
 Small Mobile
========================================== */

@media screen and (max-width:480px){

  .wemustpod-contact-art{
      flex-direction:column;
  }

  .wemustpod-contact-art-col{
      width:100%;
      min-width:100%;
  }

  .wemustpod-contact-office-meta{
      align-items:flex-start;
  }

  .wemustpod-contact-office-number{
      flex-shrink:0;
  }

}
</style>
<div
    class="wemustpod-contact-section"
    id="get-started"
    style="
      --contact-section-background: {{ section.settings.background }};
      --contact-section-padding-top: {{ section.settings.padding_top }}px;
      --contact-section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="container">

      <div class="wemustpod-contact-layout">
  
        <div class="wemustpod-contact-left">
  
          {% if section.settings.heading != blank %}
            <h2 class="wemustpod-contact-title">
              {{ section.settings.heading }}
            </h2>
          {% endif %}
  
          {% if section.settings.description != blank %}
            <div class="wemustpod-contact-text rte">
              {{ section.settings.description }}
            </div>
          {% endif %}
  
          <div class="wemustpod-contact-art">
  
            <div class="wemustpod-contact-art-col">
  
              {% if section.settings.art_image_1 != blank %}
                {{
                  section.settings.art_image_1
                  | image_url: width: 500
                  | image_tag:
                    loading: 'lazy',
                    alt: section.settings.art_image_1.alt
                }}
              {% endif %}
  
              {% if section.settings.art_image_2 != blank %}
                {{
                  section.settings.art_image_2
                  | image_url: width: 500
                  | image_tag:
                    loading: 'lazy',
                    alt: section.settings.art_image_2.alt
                }}
              {% endif %}
  
            </div>
  
            <div class="wemustpod-contact-art-col">
  
              {% if section.settings.art_image_3 != blank %}
                {{
                  section.settings.art_image_3
                  | image_url: width: 500
                  | image_tag:
                    loading: 'lazy',
                    alt: section.settings.art_image_3.alt
                }}
              {% endif %}
  
              {% if section.settings.art_image_4 != blank %}
                {{
                  section.settings.art_image_4
                  | image_url: width: 500
                  | image_tag:
                    loading: 'lazy',
                    alt: section.settings.art_image_4.alt
                }}
              {% endif %}
  
            </div>
  
            <div class="wemustpod-contact-art-col">
  
              {% if section.settings.art_image_5 != blank %}
                {{
                  section.settings.art_image_5
                  | image_url: width: 500
                  | image_tag:
                    loading: 'lazy',
                    alt: section.settings.art_image_5.alt
                }}
              {% endif %}
  
              {% if section.settings.art_image_6 != blank %}
                {{
                  section.settings.art_image_6
                  | image_url: width: 500
                  | image_tag:
                    loading: 'lazy',
                    alt: section.settings.art_image_6.alt
                }}
              {% endif %}
  
            </div>
  
          </div>
  
          {% if section.settings.button_text != blank %}
            <a
              href="{{ section.settings.button_link }}"
              class="wemustpod-contact-cta"
            >
              {{ section.settings.button_text }}
            </a>
          {% endif %}
  
        </div>
  
        <div class="wemustpod-contact-offices">
  
          {% for block in section.blocks %}
            {% case block.type %}
            {% when 'office' %}
  
            <article
              class="wemustpod-contact-office"
              {{ block.shopify_attributes }}
            >
  
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    alt: block.settings.title
                }}
              {% endif %}
  
              <div class="wemustpod-contact-office-meta">
  
                {% if block.settings.number != blank %}
                  <span class="wemustpod-contact-office-number">
                    {{ block.settings.number }}
                  </span>
                {% endif %}
  
                <div>
  
                  {% if block.settings.title != blank %}
                    <h3>{{ block.settings.title }}</h3>
                  {% endif %}
  
                  {% if block.settings.address != blank %}
                    <p>{{ block.settings.address }}</p>
                  {% endif %}
  
                </div>
  
              </div>
  
            </article>
  
            {% endcase %}
          {% endfor %}
  
        </div>
  
      </div>
  
    </div>
  </div>
  {% schema %}
{
  "name": "POD Contact",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get In Touch"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Questions about Print on Demand, store setup, or production capacity? Our team is here to help you launch faster — with sourcing, decoration, packing, and shipping under one roof across Canada and the US.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get Started Today"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },

    {
      "type": "header",
      "content": "Artwork Images"
    },

    {
      "type": "image_picker",
      "id": "art_image_1",
      "label": "Artwork 1"
    },
    {
      "type": "image_picker",
      "id": "art_image_2",
      "label": "Artwork 2"
    },
    {
      "type": "image_picker",
      "id": "art_image_3",
      "label": "Artwork 3"
    },
    {
      "type": "image_picker",
      "id": "art_image_4",
      "label": "Artwork 4"
    },
    {
      "type": "image_picker",
      "id": "art_image_5",
      "label": "Artwork 5"
    },
    {
      "type": "image_picker",
      "id": "art_image_6",
      "label": "Artwork 6"
    },

    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },

    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],

  "blocks": [
    {
      "type": "office",
      "name": "Office",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Office Image"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Office Title",
          "default": "Head Office"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "POD Contact",
      "blocks": [
        {
          "type": "office",
          "settings": {
            "number": "01",
            "title": "Head Office",
