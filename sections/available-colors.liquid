{{ 'section-available-colors.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #section-id-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    background: {{ section.settings.section_background }};
  }

  @media screen and (max-width: 767px) {
    #section-id-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="section-id-{{ section.id }}"
  class="{% if section.settings.color_scheme != 'default' %}use-color-scheme use-color-scheme--{{ section.settings.color_scheme }}{% endif %}"
>
  <div class="container{% if section.settings.full_width %} container--no-max{% endif %}">

    {% if section.settings.heading != blank %}
      <h2 class="section-title h4 spaced-row" data-cc-animate data-cc-animate-delay="0.15s">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    <div class="available-colors-wrapper fade-in-up" data-cc-animate data-cc-animate-delay="0.25s">
      <div class="color-swatch-grid">
        {% for block in section.blocks %}
          <div
            class="color-swatch{% unless block.settings.white_text %} color-swatch-white{% endunless %}"
            style="background: {{ block.settings.color }};"
            {{ block.shopify_attributes }}
          >
            <div class="color-swatch-content">
              <p class="color-swatch-name">{{ block.settings.name }}</p>

              {% if block.settings.code != blank %}
                <p class="color-swatch-code">{{ block.settings.code }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

  </div>
</div>
{% schema %}
{
  "name": "Available Colors",
  "tag": "section",
  "class": "section-available-colors",
  "settings": [
    {
      "type": "text",
      "id": "heading",
