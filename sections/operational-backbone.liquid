
<style>

/* ─────────────────────────────────────────
       OPERATIONS
    ───────────────────────────────────────── */
.wemustpod-operations-section {
    padding-top: var(--operations-padding-top);
    padding-bottom: var(--operations-padding-bottom);
    background: var(--operations-background);
}

.wemustpod-operations-layout {
    display: flex;
    flex-direction: row;
}
.wemustpod-operations-copy{
    display:flex;
    flex-direction: column;
    padding:10px;
    gap: 10px;
    flex: 0 0 35%
}
@media (max-width: 860px) {
    .wemustpod-operations-layout {
        grid-template-columns: 1fr;
    }
}

.wemustpod-operations-eyebrow {
    font-family: "Inter", Sans-serif;
    font-size: 19px;
    font-weight: 700;
    line-height: 39px;
    letter-spacing: 1.3px;
    color: #858585;
    text-transform: uppercase;
    margin:0;
}

.wemustpod-operations-title {
    font-family: "Poppins", Sans-serif;
    font-size: 40px;
    font-weight: 700;
    color: #000000;
}

.wemustpod-gelato-logo {
    border: none;
    border-radius: 0;
    box-shadow: none;
    height: auto;
    max-width: 100%;
}

.wemustpod-operations-text {
    padding: 0px 20px 0px 0px;
    text-align: start;
    font-family: "Poppins", Sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 34px;
    color: #000000;
}

.wemustpod-operation-cards {
    display: flex;
    gap: 20px;
    flex: 0 0 65%;
}

@media (max-width: 860px) {
    .wemustpod-operation-cards {
        flex-direction: column;
    }
}

.wemustpod-operation-card {
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    min-height: 0px;
    justify-content: center;
    gap: 10px;
    align-items: center;
    box-shadow: 0px 11px 9px -5px rgba(0, 0, 0, 0.34);
    
}

.wemustpod-operation-card--brand {
    background: #861528;
    color: #fff;
}

.wemustpod-operation-card--dark {
    background: #111;
    color: #fff;
}

.wemustpod-operation-card--light {
    background: #fff;
    color: #111;
    border: 1px solid #e5e5e5;
}

.wemustpod-operation-card h3 {
    font-family: "Inter", Sans-serif;
    font-size: 20px;
    font-weight: 700;
    margin:0;
    color: #FFFFFF;
}

.wemustpod-operation-divider {
    text-align: center;
    padding-block-start: 15px;
    padding-block-end: 15px;
    width:100%
}
.divider-separator{
    width: 75%;
    display:flex;
    margin: 0 auto;
    border: 1px solid #FFFFFF;
}
.wemustpod-operation-card--light .wemustpod-operation-divider  .divider-separator{
    border: 1px solid #000000;
}
.wemustpod-operation-card.wemustpod-operation-card--light  h3 {
    color:#000;
}
.wemustpod-operation-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding:10px 10px 0;
}

.wemustpod-operation-card li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding-block-end: calc(24px / 2);
    justify-content: start;
    text-align: start;
}

.wemustpod-check-icon {
    padding-inline-end: 1px;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    fill: currentColor;
}
.wemustpod-operation-card li span{
    font-size: 15px;
    font-weight: 400;   
    transition: color 0.3s;
    align-self: center;
    padding-inline-start: 5px;
}
/* ===========================
   Tablet
=========================== */

@media screen and (max-width: 990px) {

    .wemustpod-operations-layout {
        flex-direction: column;
    }

    .wemustpod-operations-copy,
    .wemustpod-operation-cards {
        flex: 0 0 100%;
        width: 100%;
    }

    .wemustpod-operation-cards {
        display: grid;
       
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .wemustpod-operation-card {
        padding:20px;
    }
    .wemustpod-operation-card:last-child {
        grid-column: 1 / -1;
        width: 50%;
        margin: 0 auto;
    }

    .wemustpod-gelato-logo {
        max-width: 100%;
        height: auto;
    }
}


/* ===========================
   Mobile
=========================== */

@media screen and (max-width: 767px) {
    .wemustpod-operations-section {
        padding-top: calc(var(--operations-padding-top)/ 2);
        padding-bottom: calc(var(--operations-padding-bottom)/2);
      }

    .wemustpod-operations-layout {
        flex-direction: column;
    }

    .wemustpod-operations-copy,
    .wemustpod-operation-cards {
        flex: 0 0 100%;
        width: 100%;
    }

    .wemustpod-operation-cards {
        display: flex;
        flex-direction: column;
    }

    .wemustpod-operation-card {
        width: 100%;
        box-sizing: border-box;
    }
    .wemustpod-operation-card:last-child {
        width: 100%;
        box-sizing: border-box;
    }
    .wemustpod-operation-card ul {
        width: 100%;
    }

    .wemustpod-operation-card li {
        width: 100%;
    }

    .wemustpod-gelato-logo {
        max-width: 100%;
        height: auto;
    }

}


/* ===========================
   Small Mobile
=========================== */

@media screen and (max-width: 480px) {

    .wemustpod-operation-card {
        width: 100%;
    }

    .wemustpod-operation-card ul,
    .wemustpod-operation-card li {
        width: 100%;
    }

}
</style>
<div
    class="wemustpod-operations-section"
    style="
      --operations-background: {{ section.settings.background }};
      --operations-text-color: {{ section.settings.text_color }};
      --operations-padding-top: {{ section.settings.padding_top }}px;
      --operations-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="container">
      <div class="wemustpod-operations-layout">
  
        <div class="wemustpod-operations-copy">
  
          {% if section.settings.eyebrow != blank %}
            <p class="wemustpod-operations-eyebrow">
              {{ section.settings.eyebrow }}
            </p>
          {% endif %}
  
          {% if section.settings.heading != blank %}
            <h2 class="wemustpod-operations-title">
              {{ section.settings.heading }}
            </h2>
          {% endif %}
  
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 379
              | image_tag:
                class: 'wemustpod-gelato-logo',
                loading: 'lazy',
                alt: section.settings.logo.alt
            }}
          {% endif %}
  
          {% if section.settings.description_1 != blank %}
            <div class="wemustpod-operations-text rte">
              {{ section.settings.description_1 }}
            </div>
          {% endif %}
  
          {% if section.settings.description_2 != blank %}
            <div class="wemustpod-operations-text rte">
              {{ section.settings.description_2 }}
            </div>
          {% endif %}
  
        </div>
  
        <div class="wemustpod-operation-cards">
  
          {% for block in section.blocks %}
            {% case block.type %}
            {% when 'operation_card' %}
  
              <article
                class="wemustpod-operation-card wemustpod-operation-card--{{ block.settings.card_style }}"
                {{ block.shopify_attributes }}
              >
  
                {% if block.settings.title != blank %}
                  <h3>{{ block.settings.title }}</h3>
                {% endif %}
  
                <div class="wemustpod-operation-divider">
                    <span class="divider-separator"></span> 
                </div>
  
                <ul>
  
                  {% if block.settings.feature_1 != blank %}
                    <li>
                      <svg class="wemustpod-check-icon" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg">
                        <path d="M400 480H48c-26.51 0-48-21.49-48-48V80c0-26.51 21.49-48 48-48h352c26.51 0 48 21.49 48 48v352c0 26.51-21.49 48-48 48zm-204.686-98.059l184-184c6.248-6.248 6.248-16.379 0-22.627l-22.627-22.627c-6.248-6.248-16.379-6.249-22.628 0L184 302.745l-70.059-70.059c-6.248-6.248-16.379-6.248-22.628 0l-22.627 22.627c-6.248 6.248-6.248 16.379 0 22.627l104 104c6.249 6.25 16.379 6.25 22.628.001z"/>
                      </svg>
                      <span>{{ block.settings.feature_1 }}</span>
                    </li>
                  {% endif %}
  
                  {% if block.settings.feature_2 != blank %}
                    <li>
                        {% render 'operation-icon-check' %}
                     
                      <span>{{ block.settings.feature_2 }}</span>
                    </li>
                  {% endif %}
  
                  {% if block.settings.feature_3 != blank %}
                    <li>
                      {% render 'operation-icon-check' %}
                      <span>{{ block.settings.feature_3 }}</span>
                    </li>
                  {% endif %}
  
                  {% if block.settings.feature_4 != blank %}
                    <li>
                      {% render 'operation-icon-check' %}
                      <span>{{ block.settings.feature_4 }}</span>
                    </li>
                  {% endif %}
  
                  {% if block.settings.feature_5 != blank %}
                    <li>
                      {% render 'operation-icon-check' %}
                      <span>{{ block.settings.feature_5 }}</span>
                    </li>
                  {% endif %}
                </ul>

            </article>

          {% endcase %}
        {% endfor %}

      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "POD Operations",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our operational backbone"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Powered By"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "richtext",
      "id": "description_1",
      "label": "Description 1",
      "default": "<p>The intelligent operating system behind our print-on-demand workflow — connecting procurement, production, and logistics into one streamlined platform for faster, more accurate fulfillment.</p>"
    },
    {
      "type": "richtext",
      "id": "description_2",
      "label": "Description 2",
      "default": "<p>From supplier syncing to automated production routing and shipping optimization, GelatoConnect helps us run a more connected operation from start to finish. The result is better accuracy, stronger visibility, and more reliable delivery across every order.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],

  "blocks": [
    {
      "type": "operation_card",
      "name": "Operation Card",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "select",
          "id": "card_style",
          "label": "Card Style",
          "default": "brand",
          "options": [
            {
              "value": "brand",
              "label": "Brand"
            },
            {
              "value": "dark",
              "label": "Dark"
            },
            {
              "value": "light",
              "label": "Light"
            }
          ]
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3"
        },
        {
          "type": "text",
          "id": "feature_4",
          "label": "Feature 4"
        },
        {
          "type": "text",
          "id": "feature_5",
          "label": "Feature 5"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "POD Operations",
      "blocks": [
        {
          "type": "operation_card",
          "settings": {
            "title": "Procurement",
            "card_style": "brand",
            "feature_1": "Auto generates POs when stock triggers hit",
            "feature_2": "Syncs S&S, SanMar & Lane Seven in real time",
            "feature_3": "AI inventory: cuts overhead up to 40%",
            "feature_4": "Pre-negotiated rates, one click",
            "feature_5": "Eliminates manual supplier chasing"
          }
        },
        {
          "type": "operation_card",
          "settings": {
            "title": "Workflow",
            "card_style": "dark",
            "feature_1": "Click-not-code automation: no IT needed",
            "feature_2": "Automated batching, imposition & routing",
            "feature_3": "Full job spec at every production station",
            "feature_4": "AI quality checks before printing",
            "feature_5": "Real-time dashboard across all machines"
          }
        },
        {
          "type": "operation_card",
          "settings": {
            "title": "Logistics",
            "card_style": "light",
            "feature_1": "80+ carriers: auto-selects best rate",
            "feature_2": "AI address validation: 75% error reduction",
            "feature_3": "Labels auto-printed, no separate step",
            "feature_4": "10–25% lower shipping costs",
            "feature_5": "98% on-time dispatch, full tracking"
          }
        }
      ]
    }
  ]
}
{% endschema %}  