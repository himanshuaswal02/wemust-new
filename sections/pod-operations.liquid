{% style %}
  #shopify-section-{{ section.id }} {
    --desktop-padding-top: {{ section.settings.padding_top }}px;
    --desktop-padding-bottom: {{ section.settings.padding_bottom }}px;
    --mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
{% endstyle %}
<div
  class="wemustpod-operations-section"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="full-width">
    <div class="wemustpod-operations-layout">
      <div class="wemustpod-operations-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="wemustpod-operations-eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="wemustpod-operations-title">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 500
            | image_tag:
              loading: 'lazy',
              class: 'wemustpod-gelato-logo'
          }}
        {% endif %}
        {% if section.settings.description_1 != blank %}
          <div class="wemustpod-operations-text rte">
            {{ section.settings.description_1 }}
          </div>
        {% endif %}
        {% if section.settings.description_2 != blank %}
          <div class="wemustpod-operations-text rte">
            {{ section.settings.description_2 }}
          </div>
        {% endif %}
      </div>
      <div class="wemustpod-operation-cards">
        {% for block in section.blocks %}
          <article
            class="wemustpod-operation-card"
            {{ block.shopify_attributes }}
            style="
              background: {{ block.settings.card_background }};
              color: {{ block.settings.text_color }};
            "
          >
            {% if block.settings.title != blank %}
              <h3 style="color: {{ block.settings.text_color }};">{{ block.settings.title }}</h3>
            {% endif %}
            <div
              class="wemustpod-operation-divider"
              style="background: {{ block.settings.icon_color }};"
            ></div>
            <ul>
              {% for i in (1..10) %}
                {% assign item_key = 'item_' | append: i %}
                {% assign item = block.settings[item_key] %}
                {% if item != blank %}
                  <li>
                    <svg
                      class="wemustpod-check-icon"
                      style="color: {{ block.settings.icon_color }};"
                      viewBox="0 0 448 512"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="currentColor"
                    >
                      <path d="M400 480H48c-26.51 0-48-21.49-48-48V80c0-26.51 21.49-48 48-48h352c26.51 0 48 21.49 48 48v352c0 26.51-21.49 48-48 48zm-204.686-98.059l184-184c6.248-6.248 6.248-16.379 0-22.627l-22.627-22.627c-6.248-6.248-16.379-6.249-22.628 0L184 302.745l-70.059-70.059c-6.248-6.248-16.379-6.248-22.628 0l-22.627 22.627c-6.248 6.248-6.248 16.379 0 22.627l104 104c6.249 6.25 16.379 6.25 22.628.001z"/>
                    </svg>
                    <span>{{ item }}</span>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pod Operations Cards",
  "tag": "section",
  "class": "section wemustpod-operations",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our operational backbone"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Powered By"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "richtext",
      "id": "description_1",
      "label": "Description 1",
      "default": "<p>The intelligent operating system behind our print-on-demand workflow — connecting procurement, production, and logistics into one streamlined platform for faster, more accurate fulfillment.</p>"
    },
    {
      "type": "richtext",
      "id": "description_2",
      "label": "Description 2",
      "default": "<p>From supplier syncing to automated production routing and shipping optimization, GelatoConnect helps us run a more connected operation from start to finish. The result is better accuracy, stronger visibility, and more reliable delivery across every order.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Operation Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Procurement"
        },
        {
          "type": "color",
          "id": "card_background",
          "label": "Card Background",
          "default": "#f5f5f5"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon & Divider Color",
          "default": "#E53935"
        },
        {
          "type": "text",
          "id": "item_1",
          "label": "Item 1"
        },
        {
          "type": "text",
          "id": "item_2",
          "label": "Item 2"
        },
        {
          "type": "text",
          "id": "item_3",
          "label": "Item 3"
        },
        {
          "type": "text",
          "id": "item_4",
          "label": "Item 4"
        },
        {
          "type": "text",
          "id": "item_5",
          "label": "Item 5"
        },
        {
          "type": "text",
          "id": "item_6",
          "label": "Item 6"
        },
        {
          "type": "text",
          "id": "item_7",
          "label": "Item 7"
        },
        {
          "type": "text",
          "id": "item_8",
          "label": "Item 8"
        },
        {
          "type": "text",
          "id": "item_9",
          "label": "Item 9"
        },
        {
          "type": "text",
          "id": "item_10",
          "label": "Item 10"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Pod Operations Cards",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}