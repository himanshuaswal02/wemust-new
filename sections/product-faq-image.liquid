{% liquid
  assign faq_section = product.metafields.custom.faq_section.value
%}

{% if faq_section != blank and faq_section.left_image != blank %}
  <link rel="stylesheet" href="{{ 'product-faq-image.css' | asset_url }}" {%- render 'lazy-stylesheet-attrs' %}>
  {{ 'product-faq-image.js' | asset_url | script_tag }}
  {% style %}
    .product-faq-image-section{
        padding-top:{{ section.settings.padding_top }}px;
        padding-bottom:{{ section.settings.padding_bottom }}px;
    }

    @media(max-width:767px){
        .product-faq-image-section{
            padding-top:{{ section.settings.mobile_padding_top }}px;
            padding-bottom:{{ section.settings.mobile_padding_bottom }}px;
        }
    }
  {% endstyle %}

  <div class="product-faq-image-section">
    <div class="page-width">
      <div class="product-faq-image">
        {% if faq_section.left_image != blank %}
          <div class="product-faq-image__left">
            {{
              faq_section.left_image
              | image_url: width: 1200
              | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200', class: 'faq-left-image'
            }}
          </div>
        {% endif %}
        <div class="product-faq-image__right">
          {% if section.settings.heading != blank %}
            <div class="product-faq-heading">
              <h2>{{ section.settings.heading }}</h2>
            </div>
          {% endif %}
          <div class="product-faq-accordion">
            {% if faq_section.faq_1_question != blank and faq_section.faq_1_answer != blank %}
              <div class="faq-item">
                <div class="faq-question">
                  <div class="faq-title">{{ faq_section.faq_1_question }}</div>
                  <div class="faq-icon">
                    <span></span>
                    <span></span>
                  </div>
                </div>
                <div class="faq-answer">
                  <div class="faq-answer-inner">
                    {{ faq_section.faq_1_answer | metafield_tag }}
                  </div>
                </div>
              </div>
            {% endif %}

            {% if faq_section.faq_2_question != blank and faq_section.faq_2_answer != blank %}
              <div class="faq-item">
